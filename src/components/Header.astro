---
import Container from './Container.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import { NAV_LINKS } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur-md">
	<Container class="flex h-[72px] items-center justify-between">
		<a href="/" class="shrink-0" aria-label="The Visibility Firm — home">
			<Logo />
		</a>

		<nav class="hidden lg:flex lg:items-center lg:gap-1" aria-label="Primary">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						class:list={[
							'rounded-full px-4 py-2 text-[14.5px] font-medium transition-colors',
							isActive(link.href)
								? 'text-ink'
								: 'text-slate hover:text-ink',
						]}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="hidden shrink-0 lg:block">
			<Button href="/contact" size="md">Book a Strategy Call</Button>
		</div>

		<button
			id="menu-toggle"
			type="button"
			class="flex h-10 w-10 items-center justify-center rounded-full text-ink lg:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Toggle menu"
		>
			<svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
			</svg>
			<svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
			</svg>
		</button>
	</Container>

	<div id="mobile-menu" class="hidden border-t border-line bg-paper lg:hidden">
		<Container class="flex flex-col gap-1 py-4">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						class:list={[
							'rounded-lg px-3 py-2.5 text-[15px] font-medium',
							isActive(link.href) ? 'bg-mist text-ink' : 'text-slate',
						]}
					>
						{link.label}
					</a>
				))
			}
			<div class="mt-2">
				<Button href="/contact" size="md" class="w-full">Book a Strategy Call</Button>
			</div>
		</Container>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	const iconOpen = document.getElementById('icon-open');
	const iconClose = document.getElementById('icon-close');

	toggle?.addEventListener('click', () => {
		const isHidden = menu?.classList.contains('hidden');
		menu?.classList.toggle('hidden');
		iconOpen?.classList.toggle('hidden');
		iconClose?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!!isHidden));
	});
</script>
