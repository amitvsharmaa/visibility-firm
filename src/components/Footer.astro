---
import Container from './Container.astro';
import Logo from './Logo.astro';
import { NAV_LINKS, CONTACT_EMAIL } from '../consts';

const year = new Date().getFullYear();

const services = [
	'CRM Systems',
	'Marketing Automation',
	'AI Workflows',
	'Reporting Dashboards',
];
---

<footer class="border-t border-line-dark bg-ink text-slate-dark">
	<Container class="py-16">
		<div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
			<div>
				<Logo variant="light" />
				<p class="mt-4 max-w-xs text-[14.5px] leading-relaxed text-slate-dark">
					AI-powered growth systems for CPA and accounting firms — CRM, marketing
					automation, and RevOps, built to work as one system.
				</p>
			</div>

			<div>
				<p class="text-xs font-semibold tracking-wide text-white/60 uppercase">Site</p>
				<ul class="mt-4 space-y-2.5">
					{
						NAV_LINKS.map((link) => (
							<li>
								<a href={link.href} class="text-[14.5px] hover:text-white">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<p class="text-xs font-semibold tracking-wide text-white/60 uppercase">What we build</p>
				<ul class="mt-4 space-y-2.5">
					{
						services.map((s) => (
							<li class="text-[14.5px]">{s}</li>
						))
					}
				</ul>
			</div>

			<div>
				<p class="text-xs font-semibold tracking-wide text-white/60 uppercase">Get in touch</p>
				<ul class="mt-4 space-y-2.5 text-[14.5px]">
					<li>
						<a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-white">{CONTACT_EMAIL}</a>
					</li>
					<li>
						<a href="/contact" class="hover:text-white">Book a strategy call &rarr;</a>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="mt-14 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-slate-dark sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} The Visibility Firm. All rights reserved.</p>
			<p>AI-powered growth systems for accounting firms.</p>
		</div>
	</Container>
</footer>

<script>
	// Site-wide scroll-reveal: fades/slides [data-reveal] elements in as they
	// enter the viewport. This is progressive enhancement — content is
	// visible by default (see global.css); we only opt into the hidden
	// starting state once we're sure JS is running and IntersectionObserver
	// is supported, so a slow/blocked/failed script can never leave content
	// permanently invisible.
	if ('IntersectionObserver' in window) {
		document.documentElement.classList.add('reveal-ready');

		const revealEls = document.querySelectorAll('[data-reveal]');
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
		);
		revealEls.forEach((el) => io.observe(el));

		// Safety net: if anything is somehow still hidden after 4s (e.g. an
		// element that never intersects due to unusual layout), force it
		// visible rather than risk it staying hidden.
		setTimeout(() => {
			document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => el.classList.add('is-visible'));
		}, 4000);
	}
</script>
