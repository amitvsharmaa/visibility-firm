---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const how = [
	'AI',
	'Marketing Automation',
	'CRM',
	'Revenue Operations',
	'Customer Journey Design',
	'Modern Web Experiences',
	'Analytics',
	'AI Search Visibility',
];

const whatWeBuild = [
	{
		title: 'CRM Systems',
		description: 'One system of record for every lead, client, and conversation — no more spreadsheets.',
		icon: 'M4 5.5h16M4 12h16M4 18.5h10',
		big: true,
		dark: true,
		glow: 'bg-accent-2/30',
	},
	{
		title: 'Marketing Automation',
		description: 'Email, SMS, and follow-up sequences that nurture leads automatically, 24/7.',
		icon: 'M4 6.5h16v11H4v-11Zm0 0 8 6 8-6',
		tone: 'bg-accent/10 text-accent',
	},
	{
		title: 'Lead Management',
		description: 'Structured pipelines so no inquiry sits unanswered and every lead gets tracked to close.',
		icon: 'M4 5h16l-6 8v6l-4-2v-4L4 5Z',
		tone: 'bg-gold/15 text-gold-dark',
	},
	{
		title: 'AI Workflows',
		description: 'AI agents that handle routine follow-up, scheduling, and admin work around the clock.',
		icon: 'M12 3v3m0 12v3M4.2 6.2l2.1 2.1m11.4 7.4 2.1 2.1M3 12h3m12 0h3M4.2 17.8l2.1-2.1m11.4-7.4 2.1-2.1M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z',
		big: true,
		dark: true,
		glow: 'bg-gold/30',
	},
	{
		title: 'Client Onboarding',
		description: 'Automated onboarding flows that set expectations and collect what you need, faster.',
		icon: 'M8 4h8l3 3v13H5V7l3-3Zm0 6h8m-8 4h5',
		tone: 'bg-accent-violet/10 text-accent-violet',
	},
	{
		title: 'Reporting Dashboards',
		description: 'Clear, live visibility into leads, pipeline, and ROI — no more guessing what is working.',
		icon: 'M4 19V9m6 10V4m6 15v-7m6 7V11',
		tone: 'bg-accent-2/10 text-accent-dark',
	},
];

const values = [
	{
		title: 'Simplicity',
		description: 'Complex businesses deserve simple systems.',
		icon: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16Z M12 9v6M9 12h6',
		tone: 'bg-accent/10 text-accent',
	},
	{
		title: 'Automation First',
		description: 'Anything repetitive should be automated.',
		icon: 'M4 4v5h5M20 20v-5h-5M4.5 15a8 8 0 0 0 14.8 3M19.5 9A8 8 0 0 0 4.7 6',
		tone: 'bg-gold/15 text-gold-dark',
	},
	{
		title: 'Business Before Technology',
		description: 'Technology exists to solve business problems — not create more complexity.',
		icon: 'M4 8h16v11H4V8Zm4 0V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M4 13h16',
		tone: 'bg-accent-violet/10 text-accent-violet',
	},
	{
		title: 'Transparency',
		description: 'Clear communication. Clear pricing. Clear results.',
		icon: 'M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
		tone: 'bg-accent-2/10 text-accent-dark',
	},
];

const process = [
	{ step: '01', title: 'Discover', description: 'We map how leads, clients, and work actually move through your firm today.' },
	{ step: '02', title: 'Design the System', description: 'We design the CRM, automation, and journey architecture around your goals.' },
	{ step: '03', title: 'Build & Automate', description: 'We implement the CRM, workflows, and AI automations end to end.' },
	{ step: '04', title: 'Optimize', description: 'We measure, refine, and improve the system continuously as your firm grows.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="relative overflow-hidden bg-ink pt-16 pb-20 sm:pt-20">
				<div class="noise-overlay"></div>
				<div class="bg-grid pointer-events-none absolute inset-0 opacity-40"></div>
				<div
					class="mesh-blob left-1/2 -top-52 h-[560px] w-[720px] -translate-x-1/2 bg-accent/35"
					style="animation: blob-drift 16s ease-in-out infinite;"
				>
				</div>
				<div
					class="mesh-blob -right-24 top-10 h-[380px] w-[380px] bg-accent-violet/25"
					style="animation: blob-drift 20s ease-in-out infinite 2s;"
				>
				</div>
				<div
					class="mesh-blob -left-24 top-64 h-[320px] w-[320px] bg-gold/20"
					style="animation: blob-drift 22s ease-in-out infinite 1s;"
				>
				</div>

				<Container class="relative">
					<div class="mx-auto max-w-3xl text-center">
						<span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium text-slate-dark">
							<span class="relative flex h-2 w-2">
								<span class="pulse-dot absolute h-2 w-2 rounded-full bg-gold"></span>
							</span>
							Live systems, built for CPA &amp; accounting firms
						</span>
						<h1 class="mt-6 text-[2.6rem] leading-[1.08] font-semibold text-white sm:text-6xl lg:text-[4.2rem]">
							Building <span class="gradient-text">AI-Powered</span> Growth Systems for Accounting Firms
						</h1>
						<p class="mx-auto mt-6 max-w-2xl text-[17px] leading-relaxed text-slate-dark">
							The Visibility Firm helps CPA and accounting firms attract, convert, and retain more
							clients through CRM, marketing automation, AI, and revenue operations — built as one
							integrated system, not another disconnected tool.
						</p>
						<div class="mt-9 flex flex-wrap items-center justify-center gap-3">
							<Button href="/contact" variant="gold" size="lg">Book a Strategy Call</Button>
							<Button href="/services" variant="secondary" size="lg" class="!bg-transparent !text-white !ring-white/20 hover:!bg-white/10">
								View Case Studies
							</Button>
						</div>
					</div>

					<!-- capability marquee -->
					<div class="marquee mt-16">
						<div class="marquee-track items-center gap-3 py-1">
							{
								[...how, ...how].map((item) => (
									<span class="mx-1.5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm font-medium whitespace-nowrap text-slate-dark">
										<span class="h-1 w-1 rounded-full bg-gold" />
										{item}
									</span>
								))
							}
						</div>
					</div>

					<!-- Dynamic floating hero visual -->
					<div id="hero-visual" class="relative mx-auto mt-16 h-[420px] max-w-4xl sm:h-[460px]" style="perspective: 1200px;">
						<div id="hero-visual-inner" class="relative h-full w-full transition-transform duration-200 ease-out" style="transform-style: preserve-3d;">
							<!-- main dashboard card -->
							<div class="glass-card absolute top-1/2 left-1/2 w-[86%] max-w-xl -translate-x-1/2 -translate-y-1/2 rounded-2xl p-3 shadow-[0_40px_120px_-30px_rgba(70,80,230,0.35)] sm:w-[72%]">
								<div class="flex items-center gap-1.5 px-2 pb-3">
									<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
									<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
									<span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
									<span class="ml-auto text-[11px] font-medium text-slate-dark">Growth System &middot; Live</span>
								</div>
								<div class="rounded-xl bg-ink/60 p-5">
									<p class="text-xs font-medium text-slate-dark">Qualified Leads — Last 10 Weeks</p>
									<div class="mt-4 flex h-32 items-end gap-1.5">
										{[38, 52, 46, 61, 58, 70, 64, 80, 76, 94].map((h) => (
											<div class="flex-1 rounded-t bg-gradient-to-t from-accent/70 to-accent-2" style={`height:${h}%`}></div>
										))}
									</div>
								</div>
							</div>

							<!-- floating card: AI agent activity -->
							<div
								class="glass-card absolute top-2 left-0 w-64 rounded-xl p-4 shadow-xl sm:top-4 sm:left-2"
								style="--float-r:-4deg; animation: float-slow 7s ease-in-out infinite;"
							>
								<div class="flex items-center gap-2">
									<span class="flex h-6 w-6 items-center justify-center rounded-full bg-accent-violet/25 text-accent-2">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="M12 3v3m0 12v3M4.2 6.2l2.1 2.1m11.4 7.4 2.1 2.1M3 12h3m12 0h3M4.2 17.8l2.1-2.1m11.4-7.4 2.1-2.1M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
									</span>
									<p class="text-xs font-semibold text-white">AI Workflow</p>
									<span class="ml-auto rounded-full bg-gold/15 px-2 py-0.5 text-[10px] font-medium text-gold">Automated</span>
								</div>
								<p class="mt-2.5 text-[12.5px] leading-snug text-slate-dark">Following up with 12 leads who haven&rsquo;t responded in 48 hours&hellip;</p>
								<div class="mt-2 flex gap-1">
									<span class="typing-dot h-1.5 w-1.5 rounded-full bg-accent-2" style="animation-delay:0ms"></span>
									<span class="typing-dot h-1.5 w-1.5 rounded-full bg-accent-2" style="animation-delay:150ms"></span>
									<span class="typing-dot h-1.5 w-1.5 rounded-full bg-accent-2" style="animation-delay:300ms"></span>
								</div>
							</div>

							<!-- floating card: new lead toast -->
							<div
								class="glass-card absolute right-0 bottom-6 w-60 rounded-xl p-4 shadow-xl sm:right-4 sm:bottom-10"
								style="--float-r:3deg; animation: float-slow 8s ease-in-out infinite 0.6s;"
							>
								<div class="flex items-center gap-2">
									<span class="flex h-6 w-6 items-center justify-center rounded-full bg-gold/20 text-gold">
										<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none"><path d="M4 5h16l-6 8v6l-4-2v-4L4 5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
									</span>
									<p class="text-xs font-semibold text-white">New Lead Captured</p>
								</div>
								<p class="mt-2.5 text-[12.5px] leading-snug text-slate-dark">Web form &middot; Jane D. requested a consultation call.</p>
								<p class="mt-1.5 text-[11px] font-medium text-accent-2">Auto-response sent &middot; 4s ago</p>
							</div>

							<!-- floating stat pill -->
							<div
								class="glass-card absolute bottom-0 left-4 rounded-xl px-4 py-3 shadow-xl sm:left-10"
								style="--float-r:-2deg; animation: float-slow 6.5s ease-in-out infinite 0.3s;"
							>
								<p class="text-[11px] font-medium text-slate-dark">Follow-ups automated</p>
								<p class="font-display text-xl font-semibold text-white">100%</p>
							</div>
						</div>
					</div>
				</Container>
			</section>

			<!-- PROBLEM -->
			<section class="py-20 sm:py-28" data-reveal>
				<Container>
					<div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
						<div>
							<p class="text-xs font-semibold tracking-widest text-accent uppercase">The problem</p>
							<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
								Most accounting firms are still running growth on spreadsheets and guesswork.
							</h2>
							<p class="prose-tvf mt-5">
								Leads slip through the cracks. Clients forget appointments. Teams waste hours on
								repetitive work. Marketing rarely produces measurable ROI. Disconnected tools and
								manual follow-up quietly cap how fast a firm can grow.
							</p>
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							{
								[
									'Leads slip through the cracks',
									'Clients forget appointments',
									'Teams waste hours on repetitive work',
									'Marketing rarely produces measurable ROI',
								].map((item) => (
									<div class="group rounded-xl border border-line bg-mist p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-lg">
										<svg class="h-5 w-5 text-accent" viewBox="0 0 20 20" fill="none" aria-hidden="true">
											<path d="M10 6v5m0 3h.01M2.5 10a7.5 7.5 0 1 1 15 0 7.5 7.5 0 0 1-15 0Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										<p class="mt-3 text-[15px] font-medium text-ink">{item}</p>
									</div>
								))
							}
						</div>
					</div>
				</Container>
			</section>

			<!-- PHILOSOPHY / HOW -->
			<section class="border-y border-line bg-mist py-20 sm:py-28" data-reveal>
				<Container>
					<div class="mx-auto max-w-2xl text-center">
						<p class="text-xs font-semibold tracking-widest text-accent uppercase">Our philosophy</p>
						<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
							We don&rsquo;t implement software. We build growth systems.
						</h2>
						<p class="prose-tvf mt-5">
							Technology should eliminate repetitive work, improve client communication, and create
							predictable growth — not add another disconnected tool to your stack.
						</p>
					</div>
					<div class="mx-auto mt-12 flex max-w-3xl flex-wrap justify-center gap-3">
						{
							how.map((item) => (
								<span class="rounded-full border border-line bg-white px-4 py-2 text-sm font-medium text-ink shadow-sm transition-transform hover:-translate-y-0.5 hover:shadow-md">
									{item}
								</span>
							))
						}
					</div>
				</Container>
			</section>

			<!-- WHAT WE BUILD — bento grid -->
			<section class="py-20 sm:py-28" id="services" data-reveal>
				<Container>
					<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
						<div class="max-w-xl">
							<p class="text-xs font-semibold tracking-widest text-accent uppercase">What we build</p>
							<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Systems, not software.</h2>
						</div>
						<Button href="/services" variant="ghost">See all services</Button>
					</div>
					<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{
							whatWeBuild.map((item) =>
								item.dark ? (
									<div
										class:list={[
											'group relative overflow-hidden rounded-2xl bg-ink p-6 shadow-[0_20px_50px_-25px_rgba(10,15,31,0.5)] transition-all duration-300 hover:-translate-y-1',
											item.big && 'lg:col-span-2',
										]}
									>
										<div class="bg-grid pointer-events-none absolute inset-0 opacity-30" />
										<div class:list={['mesh-blob -top-10 -right-10 h-40 w-40', item.glow]} />
										<span class="relative flex h-10 w-10 items-center justify-center rounded-lg bg-white/10 text-white backdrop-blur">
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
												<path d={item.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</span>
										<h3 class="relative mt-4 text-[17px] font-semibold text-white">{item.title}</h3>
										<p class="relative mt-2 text-[14.5px] leading-relaxed text-slate-dark">{item.description}</p>
									</div>
								) : (
									<div class="group relative overflow-hidden rounded-2xl border border-line p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-xl">
										<span class:list={['relative flex h-10 w-10 items-center justify-center rounded-lg', item.tone]}>
											<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
												<path d={item.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</span>
										<h3 class="relative mt-4 text-[17px] font-semibold text-ink">{item.title}</h3>
										<p class="relative mt-2 text-[14.5px] leading-relaxed text-slate">{item.description}</p>
									</div>
								),
							)
						}
					</div>
				</Container>
			</section>

			<!-- PROCESS -->
			<section class="border-y border-line bg-mist py-20 sm:py-28" data-reveal>
				<Container>
					<div class="max-w-xl">
						<p class="text-xs font-semibold tracking-widest text-accent uppercase">How we work</p>
						<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">A clear path from audit to automated system.</h2>
					</div>
					<div class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
						<div class="absolute top-6 right-0 left-0 hidden h-px bg-gradient-to-r from-transparent via-line-dark/30 to-transparent lg:block"></div>
						{
							process.map((item) => (
								<div class="relative">
									<div class="flex h-12 w-12 items-center justify-center rounded-full border border-accent/20 bg-white font-display text-sm font-semibold text-accent shadow-sm">
										{item.step}
									</div>
									<h3 class="mt-4 text-[16px] font-semibold text-ink">{item.title}</h3>
									<p class="mt-2 text-[14.5px] leading-relaxed text-slate">{item.description}</p>
								</div>
							))
						}
					</div>
				</Container>
			</section>

			<!-- VALUES -->
			<section class="py-20 sm:py-28" data-reveal>
				<Container>
					<div class="max-w-xl">
						<p class="text-xs font-semibold tracking-widest text-accent uppercase">Why The Visibility Firm</p>
						<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Built specifically for accounting firms.</h2>
						<p class="prose-tvf mt-5">
							Not a generic marketing agency, and not a software reseller — a growth partner that
							understands the accounting business.
						</p>
					</div>
					<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
						{
							values.map((value) => (
								<div class="group">
									<span class:list={['flex h-11 w-11 items-center justify-center rounded-xl transition-transform duration-300 group-hover:-translate-y-0.5', value.tone]}>
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none">
											<path d={value.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
									<h3 class="mt-4 text-[16px] font-semibold text-ink">{value.title}</h3>
									<p class="mt-2 text-[14.5px] leading-relaxed text-slate">{value.description}</p>
								</div>
							))
						}
					</div>
				</Container>
			</section>

			<!-- INSIGHTS PREVIEW -->
			{
				posts.length > 0 && (
					<section class="border-t border-line py-20 sm:py-28" data-reveal>
						<Container>
							<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
								<div class="max-w-xl">
									<p class="text-xs font-semibold tracking-widest text-accent uppercase">Insights</p>
									<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Ideas on growth, automation, and AI for accounting firms.</h2>
								</div>
								<Button href="/blog" variant="ghost">Read the blog</Button>
							</div>
							<div class="mt-12 grid gap-6 sm:grid-cols-3">
								{posts.map((post) => (
									<a href={`/blog/${post.id}/`} class="group block">
										<div class="overflow-hidden rounded-xl border border-line">
											<img src={post.data.heroImage} alt="" class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-105" />
										</div>
										<p class="mt-4 text-xs font-medium text-slate">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="mt-1.5 text-[16px] font-semibold text-ink group-hover:text-accent">{post.data.title}</h3>
									</a>
								))}
							</div>
						</Container>
					</section>
				)
			}

			<CTASection
				eyebrow="Let's talk"
				title="See what an integrated growth system looks like for your firm."
				description="Book a free strategy call — we'll map where leads are slipping through and what an automated growth system would look like for your firm."
				primaryLabel="Book a Strategy Call"
				primaryHref="/contact"
				secondaryLabel="Explore Services"
				secondaryHref="/services"
			/>
		</main>
		<Footer />

		<script>
			// Subtle pointer-parallax tilt on the hero visual — purely decorative,
			// skipped entirely for reduced-motion users.
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const wrap = document.getElementById('hero-visual');
			const inner = document.getElementById('hero-visual-inner');
			if (wrap && inner && !prefersReducedMotion && window.matchMedia('(pointer: fine)').matches) {
				wrap.addEventListener('mousemove', (e) => {
					const rect = wrap.getBoundingClientRect();
					const x = (e.clientX - rect.left) / rect.width - 0.5;
					const y = (e.clientY - rect.top) / rect.height - 0.5;
					inner.style.transform = `rotateY(${x * 6}deg) rotateX(${-y * 6}deg)`;
				});
				wrap.addEventListener('mouseleave', () => {
					inner.style.transform = 'rotateY(0deg) rotateX(0deg)';
				});
			}
		</script>
	</body>
</html>
