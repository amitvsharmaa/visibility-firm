---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import CTASection from '../components/CTASection.astro';

const title = 'About Us';
const description =
	'The Visibility Firm is an AI-powered growth consultancy helping CPA and accounting firms attract, convert, and retain more clients through CRM, automation, and RevOps.';

const pillars = [
	{
		label: 'Mission',
		copy: 'To help CPA firms become more visible, more efficient, and more profitable by combining AI, marketing automation, and modern revenue operations into one integrated growth system.',
	},
	{
		label: 'Vision',
		copy: 'To become the trusted AI growth partner for accounting firms worldwide by building intelligent systems that increase visibility, automate operations, and improve client experiences.',
	},
	{
		label: 'Purpose',
		copy: 'Most accounting firms still rely on disconnected tools, manual follow-ups, and outdated marketing. We exist to replace that with systems that work.',
	},
];

const howList = [
	'AI',
	'Marketing Automation',
	'CRM',
	'Revenue Operations',
	'Customer Journey Design',
	'Modern Web Experiences',
	'Analytics',
	'Search Visibility',
];

const whatList = [
	'CRM Systems',
	'Marketing Automation',
	'Lead Management',
	'Client Onboarding',
	'Appointment Automation',
	'Email &amp; SMS Automation',
	'AI Workflows',
	'AI Search Visibility',
	'Review Automation',
	'Reporting Dashboards',
];

const values = [
	{ title: 'Simplicity', copy: 'Complex businesses deserve simple systems.' },
	{ title: 'Automation First', copy: 'Anything repetitive should be automated.' },
	{ title: 'Business Before Technology', copy: 'Technology exists to solve business problems — not create more complexity.' },
	{ title: 'Transparency', copy: 'Clear communication. Clear pricing. Clear results.' },
	{ title: 'Continuous Improvement', copy: 'Every workflow, campaign, and system should become smarter over time.' },
];

const idealClients = ['CPA Firms', 'Accounting Firms', 'Tax Consultants'];
const futureClients = ['Law Firms', 'Financial Advisors', 'Insurance Agencies', 'Professional Service Businesses'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="border-b border-line bg-mist py-20 sm:py-28">
				<Container>
					<div class="mx-auto max-w-3xl text-center">
						<p class="text-xs font-semibold tracking-widest text-accent uppercase">About us</p>
						<h1 class="mt-4 text-4xl font-semibold sm:text-5xl">
							Not another marketing agency. A growth systems partner.
						</h1>
						<p class="prose-tvf mx-auto mt-6 max-w-2xl text-[17px]">
							The Visibility Firm is an AI-powered growth and marketing automation consultancy
							helping CPA and accounting firms attract, convert, and retain more clients through
							CRM, RevOps, AI, and automation.
						</p>
					</div>
				</Container>
			</section>

			<Container class="max-w-5xl">
				<img
					src="/blog-placeholder-about.jpg"
					alt=""
					class="-mt-10 aspect-[21/9] w-full rounded-2xl object-cover shadow-[0_20px_60px_-20px_rgba(10,15,31,0.25)] sm:-mt-12"
				/>
			</Container>

			<!-- MISSION / VISION / PURPOSE -->
			<section class="py-20 sm:py-28">
				<Container>
					<div class="grid gap-6 lg:grid-cols-3">
						{
							pillars.map((p) => (
								<div class="rounded-2xl border border-line p-8">
									<p class="text-xs font-semibold tracking-widest text-accent uppercase">{p.label}</p>
									<p class="prose-tvf mt-4 text-[15.5px]">{p.copy}</p>
								</div>
							))
						}
					</div>
				</Container>
			</section>

			<!-- WHY WE EXIST -->
			<section class="border-y border-line bg-ink py-20 text-white sm:py-28">
				<Container>
					<div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
						<div>
							<p class="text-xs font-semibold tracking-widest text-gold uppercase">Why we exist</p>
							<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">
								We don&rsquo;t simply install software. We design growth systems.
							</h2>
						</div>
						<div class="space-y-5 text-[15.5px] leading-relaxed text-slate-dark">
							<p>
								Most accounting firms still rely on disconnected tools, manual follow-ups,
								spreadsheets, and outdated marketing. Leads slip through the cracks. Clients forget
								appointments. Teams waste hours on repetitive work. Marketing rarely produces
								measurable ROI.
							</p>
							<p>
								The Visibility Firm exists to solve these problems — by designing growth systems
								that automate client acquisition, streamline operations, and help firms scale with
								confidence.
							</p>
							<p class="border-l-2 border-gold pl-5 text-white italic">
								We believe accounting firms should spend their time serving clients — not chasing
								leads, sending reminders, updating spreadsheets, or managing disconnected software.
							</p>
						</div>
					</div>
				</Container>
			</section>

			<!-- HOW / WHAT -->
			<section class="py-20 sm:py-28">
				<Container>
					<div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
						<div>
							<p class="text-xs font-semibold tracking-widest text-accent uppercase">The how</p>
							<h2 class="mt-4 text-2xl font-semibold sm:text-3xl">What we combine</h2>
							<p class="prose-tvf mt-4 text-[15px]">
								to create systems that work together instead of isolated tools.
							</p>
							<ul class="mt-6 grid grid-cols-2 gap-3">
								{
									howList.map((item) => (
										<li class="rounded-lg border border-line px-4 py-2.5 text-sm font-medium text-ink">
											{item}
										</li>
									))
								}
							</ul>
						</div>
						<div>
							<p class="text-xs font-semibold tracking-widest text-accent uppercase">The what</p>
							<h2 class="mt-4 text-2xl font-semibold sm:text-3xl">What we build</h2>
							<p class="prose-tvf mt-4 text-[15px]">so nothing falls through the cracks.</p>
							<ul class="mt-6 grid grid-cols-2 gap-3">
								{
									whatList.map((item) => (
										<li class="rounded-lg bg-mist px-4 py-2.5 text-sm font-medium text-ink" set:html={item} />
									))
								}
							</ul>
						</div>
					</div>
				</Container>
			</section>

			<!-- BRAND PROMISE -->
			<section class="border-y border-line bg-mist py-16">
				<Container>
					<p class="mx-auto max-w-2xl text-center font-display text-2xl font-semibold text-ink sm:text-3xl">
						&ldquo;We don&rsquo;t just implement software. We build growth systems.&rdquo;
					</p>
				</Container>
			</section>

			<!-- VALUES -->
			<section class="py-20 sm:py-28">
				<Container>
					<div class="max-w-xl">
						<p class="text-xs font-semibold tracking-widest text-accent uppercase">Core values</p>
						<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">What guides how we work.</h2>
					</div>
					<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
						{
							values.map((v) => (
								<div>
									<h3 class="text-[16px] font-semibold text-ink">{v.title}</h3>
									<p class="mt-2 text-[14.5px] leading-relaxed text-slate">{v.copy}</p>
								</div>
							))
						}
					</div>
				</Container>
			</section>

			<!-- IDEAL CLIENT -->
			<section class="border-t border-line py-20 sm:py-28">
				<Container>
					<div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
						<div>
							<p class="text-xs font-semibold tracking-widest text-accent uppercase">Who we help</p>
							<h2 class="mt-4 text-3xl font-semibold sm:text-4xl">Built for accounting &amp; tax firms.</h2>
							<div class="mt-6 flex flex-wrap gap-2">
								{
									idealClients.map((c) => (
										<span class="rounded-full bg-ink px-4 py-2 text-sm font-medium text-white">{c}</span>
									))
								}
							</div>
						</div>
						<div>
							<p class="text-xs font-semibold tracking-widest text-slate uppercase">Future expansion</p>
							<p class="prose-tvf mt-4 text-[15px]">
								As our systems mature, we plan to bring the same approach to adjacent
								professional-service businesses:
							</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{
									futureClients.map((c) => (
										<span class="rounded-full border border-line px-4 py-2 text-sm font-medium text-slate">{c}</span>
									))
								}
							</div>
						</div>
					</div>
				</Container>
			</section>

			<CTASection
				eyebrow="Work with us"
				title="Ready to build a growth system for your firm?"
				description="Book a free strategy call and we'll show you exactly where your firm is losing leads and time today."
			/>
		</main>
		<Footer />
	</body>
</html>
